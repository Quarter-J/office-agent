# ============================================================
# Office Agent 环境变量配置（示例文件）
# 复制此文件为 .env 并填入你的配置
# ============================================================

# ============================================================
# LLM 配置（必填）
# ============================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7

# ============================================================
# QQ 机器人配置（OneBot 协议，可选）
# ============================================================
QQ_BOT_WS_URL=ws://127.0.0.1:6700
QQ_BOT_HTTP_URL=http://127.0.0.1:5700
QQ_BOT_ACCESS_TOKEN=

# ============================================================
# 企业微信机器人（可选）
# ============================================================
WECOM_WEBHOOK_URL=
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=

# ============================================================
# 钉钉机器人（可选）
# ============================================================
DINGTALK_WEBHOOK_URL=
DINGTALK_ACCESS_TOKEN=

# ============================================================
# 邮件配置（可选）
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ============================================================
# 知识库配置
# ============================================================
KNOWLEDGE_BASE_DIR=./data/knowledge_base
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=
# 嵌入模型独立 key（千问/DashScope 等）。留空则复用 OPENAI_API_KEY
# 千问示例：EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#           EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_API_KEY=
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.3
ENABLE_OCR=False

# ============================================================
# 存储配置
# ============================================================
DATABASE_PATH=data/db/office_agent.db
ACTION_LEDGER_PATH=data/db/action_ledger.db
VECTOR_STORE_PATH=data/db/vector_store

# ============================================================
# 定时任务配置（预留）
# ============================================================
SCHEDULER_ENABLED=False
SCHEDULER_LOG_LEVEL=INFO

# 执行时限（秒）；仅查询操作允许有限重试，消息发送超时不自动重发。
TASK_TIMEOUT_SECONDS=120
TOOL_TIMEOUT_SECONDS=30
LLM_TIMEOUT_SECONDS=30
EMBEDDING_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=10
READONLY_TIMEOUT_RETRIES=1

# 模型上下文预算：根据服务商实际窗口调整；本地使用保守文本估算。
LLM_CONTEXT_WINDOW_TOKENS=32768
LLM_OUTPUT_TOKENS=4096
LLM_CONTEXT_SAFETY_TOKENS=1024
CONTEXT_OBSERVATION_TOKENS=2048
CONTEXT_RECENT_TURNS=3

# 兼容旧配置名称，以下两个 *_TURNS 实际单位均为“消息条数”。
MEMORY_SHORT_TERM_MAX_TURNS=20
MEMORY_SUMMARY_TRIGGER_TURNS=10
MEMORY_SUMMARY_MAX_CHARS=800
